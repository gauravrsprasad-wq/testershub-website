{
  "info": {
    "_postman_id": "b5e18f73-4f77-43f6-88fa-866f66e789d5",
    "name": "TestersHub live site checks",
    "description": "HTTP-level checks for https://testershub.in: status codes, redirects, security headers, SEO files and response times. Run with Newman in CI after each deploy and every morning.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Home page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "description": "Main page: status, content, security headers and speed."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const html = pm.response.text();",
              "",
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Served as HTML\", () => {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\");",
              "});",
              "",
              "pm.test(`Responds in under ${pm.variables.get(\"maxResponseMs\")} ms`, () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(Number(pm.variables.get(\"maxResponseMs\")));",
              "});",
              "",
              "pm.test(\"Title mentions TestersHub\", () => {",
              "    pm.expect(html).to.match(/<title>[^<]*TestersHub/);",
              "});",
              "",
              "pm.test(\"Canonical URL is https://testershub.in/\", () => {",
              "    pm.expect(html).to.include('<link rel=\"canonical\" href=\"https://testershub.in/\">');",
              "});",
              "",
              "pm.test(\"Contact form is connected to Web3Forms\", () => {",
              "    pm.expect(html).to.include('name=\"access_key\"');",
              "    pm.expect(html).to.include(\"https://api.web3forms.com/submit\");",
              "});",
              "",
              "pm.test(\"No phone number is exposed\", () => {",
              "    pm.expect(html).to.not.match(/wa\\.me|tel:|\\+91[\\s-]?\\d{5}/);",
              "});",
              "",
              "pm.test(\"Security header: X-Frame-Options is DENY\", () => {",
              "    pm.expect(pm.response.headers.get(\"X-Frame-Options\")).to.eql(\"DENY\");",
              "});",
              "",
              "pm.test(\"Security header: X-Content-Type-Options is nosniff\", () => {",
              "    pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\");",
              "});",
              "",
              "pm.test(\"Security header: Referrer-Policy is set\", () => {",
              "    pm.expect(pm.response.headers.get(\"Referrer-Policy\")).to.eql(\"strict-origin-when-cross-origin\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "HTTP to HTTPS redirect",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{httpUrl}}/",
        "description": "Visitors typing http:// must be sent to the secure site."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP permanently redirects to HTTPS\", () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([301, 308]);",
              "});",
              "",
              "pm.test(\"Redirects to https://testershub.in\", () => {",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.match(/^https:\\/\\/testershub\\.in\\/?/);",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
